{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "home-barbershop-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "define": { "process.env.NODE_ENV": "\"production\"" },
  "vars": {
    "RUNTIME_TARGET": "cloudflare",
    "WEB_ORIGIN": "https://home-barbershop-web.pages.dev",
    "SUPABASE_URL": "https://azebvkknyursakzaldkl.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_x2lSNYHjCHv_dnom2OnZGA_IAPnwBtL"
  },
  "secrets": { "required": ["SUPABASE_SECRET_KEY"] },
  "placement": { "region": "aws:us-east-1" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
